<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="data_quality_monitor.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="7255"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="customers" custom_title="0" dock_id="1" table="4,9:maincustomers"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000010100ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- Reset existing objects
DROP VIEW IF EXISTS data_quality_report;

DROP TABLE IF EXISTS data_quality_issues;
DROP TABLE IF EXISTS orders;
DROP TABLE IF EXISTS customers;


-- Create customer data
CREATE TABLE customers (
    customer_id INTEGER PRIMARY KEY,
    name VARCHAR NOT NULL,
    email VARCHAR
);


-- Create order data
CREATE TABLE orders (
    order_id INTEGER PRIMARY KEY,
    customer_id INTEGER NOT NULL,
    order_date DATE,
    amount DECIMAL(10,2),
    status VARCHAR
);


-- Store detected data-quality issues
CREATE TABLE data_quality_issues (
    issue_id INTEGER PRIMARY KEY,
    table_name VARCHAR NOT NULL,
    column_name VARCHAR NOT NULL,
    issue_type VARCHAR NOT NULL,
    record_id INTEGER,
    description VARCHAR NOT NULL
);


-- Add customer records
INSERT INTO customers (customer_id, name, email)
VALUES
    (1, 'Rahul', 'rahul@gmail.com'),
    (2, 'Priya', 'priya@gmail.com'),
    (3, 'Arjun', 'arjun@gmail.com'),
    (4, 'Sneha', 'sneha@gmail.com'),
    (5, '', 'amit@gmail.com'),
    (6, 'Neha', NULL);


-- Add order records
INSERT INTO orders
(order_id, customer_id, order_date, amount, status)
VALUES
    (1, 1, '2026-08-01', 1200.00, 'Completed'),
    (2, 2, '2026-08-03', 750.50, 'Completed'),
    (3, 1, '2026-08-05', 450.00, 'Pending'),
    (4, 3, '2026-08-07', 2100.00, 'Completed'),
    (5, 4, '2026-08-10', 300.00, 'Cancelled'),
    (6, 5, '2026-08-12', -500.00, 'Completed'),
    (7, 99, '2026-08-13', 800.00, 'Completed'),
    (8, 6, NULL, 450.00, 'Pending'),
    (9, 2, '2026-08-15', 900.00, 'Unknown'),
    (10, 3, '2026-08-16', NULL, 'Completed');


-- Find missing customer names
SELECT *
FROM customers
WHERE name IS NULL OR name = '';


-- Find missing customer emails
SELECT *
FROM customers
WHERE email IS NULL OR email = '';


-- Find invalid email formats
SELECT *
FROM customers
WHERE email IS NOT NULL
  AND email NOT LIKE '%@%';


-- Find negative order amounts
SELECT *
FROM orders
WHERE amount &lt; 0;


-- Find missing order dates
SELECT *
FROM orders
WHERE order_date IS NULL;


-- Find missing order amounts
SELECT *
FROM orders
WHERE amount IS NULL;


-- Find invalid order statuses
SELECT *
FROM orders
WHERE status NOT IN (
    'Completed',
    'Pending',
    'Cancelled'
);


-- Find orders linked to unknown customers
SELECT
    orders.order_id,
    orders.customer_id,
    orders.amount
FROM orders
LEFT JOIN customers
    ON orders.customer_id = customers.customer_id
WHERE customers.customer_id IS NULL;


-- Store missing customer names
INSERT INTO data_quality_issues
(table_name, column_name, issue_type, record_id, description)
SELECT
    'customers',
    'name',
    'Missing Value',
    customer_id,
    'Customer name is empty'
FROM customers
WHERE name IS NULL OR name = '';


-- Store missing customer emails
INSERT INTO data_quality_issues
(table_name, column_name, issue_type, record_id, description)
SELECT
    'customers',
    'email',
    'Missing Value',
    customer_id,
    'Customer email is missing'
FROM customers
WHERE email IS NULL OR email = '';


-- Store negative order amounts
INSERT INTO data_quality_issues
(table_name, column_name, issue_type, record_id, description)
SELECT
    'orders',
    'amount',
    'Negative Amount',
    order_id,
    'Order amount cannot be negative'
FROM orders
WHERE amount &lt; 0;


-- Store missing order dates
INSERT INTO data_quality_issues
(table_name, column_name, issue_type, record_id, description)
SELECT
    'orders',
    'order_date',
    'Missing Value',
    order_id,
    'Order date is missing'
FROM orders
WHERE order_date IS NULL;


-- Store missing order amounts
INSERT INTO data_quality_issues
(table_name, column_name, issue_type, record_id, description)
SELECT
    'orders',
    'amount',
    'Missing Value',
    order_id,
    'Order amount is missing'
FROM orders
WHERE amount IS NULL;


-- Store invalid order statuses
INSERT INTO data_quality_issues
(table_name, column_name, issue_type, record_id, description)
SELECT
    'orders',
    'status',
    'Invalid Value',
    order_id,
    'Order status is invalid'
FROM orders
WHERE status NOT IN (
    'Completed',
    'Pending',
    'Cancelled'
);


-- Store invalid customer references
INSERT INTO data_quality_issues
(table_name, column_name, issue_type, record_id, description)
SELECT
    'orders',
    'customer_id',
    'Invalid Reference',
    order_id,
    'Customer does not exist'
FROM orders
WHERE customer_id NOT IN (
    SELECT customer_id
    FROM customers
);


-- Create the quality summary
CREATE VIEW data_quality_report AS

SELECT
    'Customers - Missing Name' AS check_name,
    COUNT(*) AS issue_count,
    CASE
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END AS result
FROM customers
WHERE name IS NULL OR name = ''

UNION ALL

SELECT
    'Customers - Missing Email',
    COUNT(*),
    CASE
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END
FROM customers
WHERE email IS NULL OR email = ''

UNION ALL

SELECT
    'Customers - Invalid Email',
    COUNT(*),
    CASE
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END
FROM customers
WHERE email IS NOT NULL
  AND email NOT LIKE '%@%'

UNION ALL

SELECT
    'Orders - Negative Amount',
    COUNT(*),
    CASE
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END
FROM orders
WHERE amount &lt; 0

UNION ALL

SELECT
    'Orders - Missing Amount',
    COUNT(*),
    CASE
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END
FROM orders
WHERE amount IS NULL

UNION ALL

SELECT
    'Orders - Missing Date',
    COUNT(*),
    CASE
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END
FROM orders
WHERE order_date IS NULL

UNION ALL

SELECT
    'Orders - Invalid Status',
    COUNT(*),
    CASE
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END
FROM orders
WHERE status NOT IN (
    'Completed',
    'Pending',
    'Cancelled'
)

UNION ALL

SELECT
    'Orders - Invalid Customer',
    COUNT(*),
    CASE
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END
FROM orders
LEFT JOIN customers
    ON orders.customer_id = customers.customer_id
WHERE customers.customer_id IS NULL;


-- View the quality report
SELECT *
FROM data_quality_report;


-- View all detected issues
SELECT *
FROM data_quality_issues
ORDER BY issue_id;


-- Calculate the order quality score
SELECT
    COUNT(*) AS total_orders,

    SUM(
        CASE
            WHEN amount &lt; 0
              OR amount IS NULL
              OR order_date IS NULL
              OR status NOT IN (
                  'Completed',
                  'Pending',
                  'Cancelled'
              )
              OR customer_id NOT IN (
                  SELECT customer_id
                  FROM customers
              )
            THEN 1
            ELSE 0
        END
    ) AS problematic_orders,

    ROUND(
        100.0 *
        (
            COUNT(*)
            -
            SUM(
                CASE
                    WHEN amount &lt; 0
                      OR amount IS NULL
                      OR order_date IS NULL
                      OR status NOT IN (
                          'Completed',
                          'Pending',
                          'Cancelled'
                      )
                      OR customer_id NOT IN (
                          SELECT customer_id
                          FROM customers
                      )
                    THEN 1
                    ELSE 0
                END
            )
        ) / COUNT(*),
        2
    ) AS quality_score

FROM orders;</sql><current_tab id="0"/></tab_sql></sqlb_project>
